# Database
DATABASE_URL="postgresql://user:password@localhost:5432/codebase_analysis"

# API
PORT=3000

# IBM Bob Shell provider
BOBSHELL_API_KEY=your-api-key-here
BOB_COMMAND=bob
BOB_PROVIDER_ENABLED=false

# OpenCode CLI provider
# OpenCode is installed in the Docker image by default. Enable after adding
# provider auth/API keys or after running the container auth flow.
OPENCODE_PROVIDER_ENABLED=false
OPENCODE_COMMAND=opencode
# Optional. If empty, OpenCode uses its own saved/default model configuration.
# Example: anthropic/claude-sonnet-4-20250514
OPENCODE_MODEL=
OPENCODE_AGENT=plan
# Add whichever provider keys your OpenCode model needs, for example:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Native Ollama HTTP provider
OLLAMA_PROVIDER_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=granite4.1:8b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_MAX_INLINE_BYTES=200000
# Used by docker-compose when Ollama is installed separately on the host.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Filesystem
WORKSPACE_ROOT=tmp/workspaces
EXPORT_ROOT=exports

# Worker
JOB_MAX_ATTEMPTS=3
JOB_STALE_TIMEOUT_SECONDS=300
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1
