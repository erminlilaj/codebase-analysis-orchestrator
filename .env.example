# Database
DATABASE_URL="postgresql://user:password@localhost:5432/codebase_analysis"

# API
PORT=3000

# IBM Bob Shell provider
BOBSHELL_API_KEY=your-api-key-here
BOB_COMMAND=bob

# Filesystem
WORKSPACE_ROOT=tmp/workspaces
EXPORT_ROOT=exports

# Worker
JOB_MAX_ATTEMPTS=3
JOB_STALE_TIMEOUT_SECONDS=300
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=4
