{
  "name": "codebase-analysis-orchestrator",
  "version": "0.1.0",
  "description": "Backend orchestration system for AI-powered batch analysis of large software repositories",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/worker.ts",
    "build": "tsc",
    "build:server": "tsc -p tsconfig.build.json",
    "build:docker": "npm run db:generate && npm run build:server && npm run web:build",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/worker/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tui.json && tsc --noEmit -p tsconfig.web.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "e2e": "tsx scripts/e2e.ts",
    "tui": "tsx src/tui/index.tsx",
    "web": "vite",
    "web:build": "vite build",
    "start:dev": "concurrently -n api,web -c cyan,magenta \"npm run dev\" \"npm run web\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.0",
    "ink": "^4.4.1",
    "ink-select-input": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.14",
    "prisma": "^5.22.0",
    "react-router-dom": "^6.30.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
