       IDENTIFICATION DIVISION.
       PROGRAM-ID. ORDPROC.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY CUSTOMER.
       COPY ORDERREC.
       COPY PRICING.
       01  WS-DISCOUNTED-TOTAL       PIC 9(7)V99 VALUE 0.
       01  WS-TAX-AMOUNT             PIC 9(7)V99 VALUE 0.
       01  WS-FINAL-TOTAL            PIC 9(7)V99 VALUE 0.
       PROCEDURE DIVISION.
       MAIN-PARA.
           MOVE "C1001" TO CUSTOMER-ID
           MOVE "ACME SUPPLY" TO CUSTOMER-NAME
           MOVE 5 TO ORDER-QUANTITY
           MOVE 125.50 TO ORDER-UNIT-PRICE
           PERFORM CALCULATE-TOTAL
           DISPLAY "CUSTOMER: " CUSTOMER-NAME
           DISPLAY "FINAL TOTAL: " WS-FINAL-TOTAL
           STOP RUN.

       CALCULATE-TOTAL.
           COMPUTE ORDER-GROSS-TOTAL =
               ORDER-QUANTITY * ORDER-UNIT-PRICE
           IF ORDER-GROSS-TOTAL > DISCOUNT-THRESHOLD
               COMPUTE WS-DISCOUNTED-TOTAL =
                   ORDER-GROSS-TOTAL -
                   (ORDER-GROSS-TOTAL * DISCOUNT-RATE)
           ELSE
               MOVE ORDER-GROSS-TOTAL TO WS-DISCOUNTED-TOTAL
           END-IF
           COMPUTE WS-TAX-AMOUNT =
               WS-DISCOUNTED-TOTAL * TAX-RATE
           COMPUTE WS-FINAL-TOTAL =
               WS-DISCOUNTED-TOTAL + WS-TAX-AMOUNT.
